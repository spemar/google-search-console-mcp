# Local dev secrets. Copy to .dev.vars (git-ignored) before running `wrangler dev`.
# In production, set these via:
#   wrangler secret put GOOGLE_OAUTH_CLIENT_ID
#   wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET
#   wrangler secret put MCP_BEARER_TOKEN

# Google OAuth Client (Web application). See docs/SETUP_GCP.md
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# Google Ads API (Optional: set operator default developer token and manager customer ID)
# Obtain developer token from Google Ads Manager Account -> Tools & Settings -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# SERP & Google AI Overview Checker API keys (Optional)
# Primary: SerpApi (250 free searches/month recurring) -> https://serpapi.com
SERPAPI_API_KEY=your-serpapi-api-key
# Secondary Fallback: Serper.dev (2,500 free queries + $0.001/query) -> https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Microsoft Clarity Data Export API (Optional)
# Generate token: Clarity Project Settings -> Data Export -> Generate new API token
# Option 1: Single default project token
CLARITY_API_TOKEN=your-clarity-jwt-token
# Option 2: Multi-project JSON map (alias/domain -> JWT token)
CLARITY_PROJECT_TOKENS={"aiskyla":"token_1","openrees":"token_2","calorieinsight":"token_3"}

# DataForSEO v3 API Credentials (Optional operator defaults for Backlinks, Keyword Difficulty & SERP Rankings)
# Register at: https://dataforseo.com (API dashboard: https://app.dataforseo.com)
DATAFORSEO_LOGIN=your-dataforseo-login-email
DATAFORSEO_PASSWORD=your-dataforseo-api-password
DATAFORSEO_API_KEY=base64-encoded-login-colon-password

# Random opaque string used as a connector access gate.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=replace-me-with-a-long-random-secret



